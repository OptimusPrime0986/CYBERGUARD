# Copy to .env. No secrets are needed in Phase 1/2.
# PIN THIS: replace with an exact tag (or @sha256 digest) you have verified exists on Docker Hub
# for owasp/modsecurity-crs (nginx variant). Do NOT use a floating tag like :nginx in production.
CRS_IMAGE=owasp/modsecurity-crs:4.3.0-nginx-202406090606

# Phase 1 host ports (bound to 127.0.0.1 only)
PORT_BLOCKING=8081
PORT_DETECT=8082
PORT_OFF=8083

# CRS paranoia level (1 = fewest false positives)
PARANOIA=1
ANOMALY_INBOUND=5

# ---- Phase 2/3 dashboard (REQUIRED for docker-compose.phase2.yml; compose refuses to start if empty) ----
# Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
CG_SECRET_KEY=
CG_ADMIN_EMAIL=
# 12+ characters. Used only to create the first admin on first start; remove it from .env afterwards.
CG_ADMIN_PASSWORD=
# Keep true. Chrome/Firefox still accept it on http://127.0.0.1; set false only for Safari or plain-http non-local testing.
CG_COOKIE_SECURE=true
